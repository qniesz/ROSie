# ROSie Dev Environment — copy to .env and fill in your values

PI_HOST=
PI_HOST_ETH=
PI_USER=rosie
PI_PASS=
PI_PORT=22

# MQTT Broker (HA Mosquitto add-on)
MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=

# Home Assistant Samba share
HA_SAMBA_HOST=
HA_SAMBA_USER=
HA_SAMBA_PASS=

# Home Assistant API
HA_URL=
HA_TOKEN=

# Neato robot identifiers
ROBOT_SERIAL=
ROBOT_MAC=
ROBOT_WIFI_IP=
